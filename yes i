  <div class="closing-content">
    <p class="closing-message reveal">"Thank you for being part of my 18th chapter."</p>
    <p class="closing-signoff reveal reveal-delay-1">With Love,</p>
    <p class="closing-name reveal reveal-delay-1">Adorlee</p>
    <div class="closing-actions reveal reveal-delay-2">
      <button class="btn btn-ghost" id="downloadInviteBtn">Download Invitation</button>
      <button class="btn btn-primary" id="shareBtn">Share This Invitation</button>
    </div>
  </div>
</section>

<footer>
  <div class="container">
    <p>Made with love for Adorlee's 18th Birthday Debut &middot; A Dream in Blue &amp; Gold</p>
  </div>
</footer>

