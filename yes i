  .nav-links.open { transform: translateX(0); }
  .nav-toggle { display: block; }
  .nav-links a { font-size: 1rem; }

  .hero { padding-top: 130px; }
  .hero-meta { flex-direction: column; gap: 10px; }

  .form-row { grid-template-columns: 1fr; }
  .form-panel { padding: 30px 22px; }

  .countdown-unit { min-width: 78px; padding: 18px 10px; }

  .gallery-grid { grid-template-columns: 1fr 1fr; grid-auto-rows: 130px; }

  .back-to-top { right: 16px; bottom: 16px; width: 44px; height: 44px; }
}

/* =========================================================
   RESPONSIVE — MOBILE PHONE (≤480px)
   Rebuilds spacing, type scale, and touch targets for phones
   rather than just shrinking the desktop layout.
   ========================================================= */

@media (max-width: 480px) {

  html { -webkit-text-size-adjust: 100%; }

  .container { padding: 0 18px; }

  section { padding: 68px 0; }

  h1, h2, h3, h4 { word-wrap: break-word; }

  .section-title { font-size: clamp(1.7rem, 7vw, 2.2rem); margin-bottom: 14px; }
  .section-sub { font-size: 0.95rem; margin-bottom: 40px; padding: 0 6px; }
