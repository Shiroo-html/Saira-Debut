<!-- ============ MESSAGES ============ -->
<section class="messages" id="messages">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">From Those Who Love Her</span>
      <h2 class="section-title">Words from the Heart</h2>
    </div>
    <p class="section-sub reveal">Gentle words, left for her to treasure always.</p>
    <div class="message-grid" id="messageGrid">
      <div class="message-card reveal">
        <span class="quote-mark">&ldquo;</span>
        <p>Watching you grow into the woman you are today has been our greatest joy. Happy 18th, our darling.</p>
        <span class="from">Mom &amp; Dad</span>
      </div>
      <div class="message-card reveal reveal-delay-1">
        <span class="quote-mark">&ldquo;</span>
        <p>From childhood giggles to late-night talks, I'm so lucky to call you my best friend. Cheers to eighteen!</p>
        <span class="from">Your Best Friend</span>
      </div>
      <div class="message-card reveal reveal-delay-2">
        <span class="quote-mark">&ldquo;</span>
        <p>May this new chapter be filled with as much light as you bring into every room you enter.</p>
        <span class="from">Ninang Grace</span>
      </div>
    </div>

    <div class="form-panel message-form-card reveal">
      <div class="section-head" style="margin-bottom: 30px;">
        <h3 style="font-family: var(--font-display); font-size: 1.6rem;">Leave Your Own Message</h3>
      </div>
      <form id="messageForm" novalidate>
        <div class="field">
          <label for="msgName">Your Name</label>
          <input type="text" id="msgName" name="msgName" placeholder="e.g. Tita Anna" required>
        </div>
        <div class="field">
          <label for="msgText">Your Message</label>
          <textarea id="msgText" name="msgText" placeholder="Share a wish, a memory, or a blessing..." required></textarea>
        </div>
        <button type="submit" class="btn btn-primary form-submit">Send Message</button>
      </form>
      <div class="form-success" id="messageSuccess">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 6L9 17l-5-5"/></svg>
        <h3>Message Received</h3>
        <p>Thank you for your sweet words — they will be treasured.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ RSVP ============ -->
<section class="rsvp" id="rsvp">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Kindly Respond</span>
      <h2 class="section-title">Will You Celebrate With Me?</h2>
    </div>
    <p class="section-sub reveal">Please let us know if you'll be joining the celebration by [RSVP Deadline].</p>

    <div class="form-panel reveal" style="max-width: 720px; margin: 0 auto;">
      <form id="rsvpForm" novalidate>
        <div class="form-row">
          <div class="field">
            <label for="rsvpName">Full Name</label>
            <input type="text" id="rsvpName" name="rsvpName" placeholder="Your full name" required>
          </div>
          <div class="field">
            <label for="rsvpGuests">Number of Guests</label>
            <input type="number" id="rsvpGuests" name="rsvpGuests" min="1" max="10" placeholder="e.g. 2" required>
          </div>
        </div>

        <div class="field full">
          <label>Will you be attending?</label>
          <div class="radio-group" id="attendanceGroup">
            <label class="radio-pill" data-value="yes">
              <input type="radio" name="attendance" value="yes" required>
              Joyfully Accepts
            </label>
            <label class="radio-pill" data-value="no">
              <input type="radio" name="attendance" value="no">
              Regretfully Declines
            </label>
          </div>
        </div>

        <div class="field full">
          <label for="rsvpMessage">Message (optional)</label>
          <textarea id="rsvpMessage" name="rsvpMessage" placeholder="A note for the debutant..."></textarea>
        </div>

        <button type="submit" class="btn btn-primary form-submit">Submit RSVP</button>
        <p class="form-note">Kindly respond by [RSVP Deadline]. We can't wait to celebrate with you.</p>
      </form>

      <div class="form-success" id="rsvpSuccess">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 6L9 17l-5-5"/></svg>
        <h3>Thank You!</h3>
        <p>Your RSVP has been received. We look forward to celebrating with you.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ VENUE ============ -->
<section class="venue" id="venue">
  <div class="container venue-grid">
    <div class="venue-copy reveal">
      <span class="eyebrow">Getting There</span>
      <h3>[Venue Name]</h3>
      <p class="venue-address">[Street Address, City, Province, ZIP Code]<br>Free parking available on-site.</p>
      <a href="#" class="btn btn-primary" id="directionsBtn">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s7-6.4 7-12a7 7 0 1 0-14 0c0 5.6 7 12 7 12Z"/><circle cx="12" cy="9" r="2.4"/></svg>
        Get Directions
      </a>
    </div>
    <div class="venue-map reveal reveal-delay-1">
      <div class="venue-map-placeholder">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M12 21s7-6.4 7-12a7 7 0 1 0-14 0c0 5.6 7 12 7 12Z"/><circle cx="12" cy="9" r="2.4"/></svg>
        <span>Map preview — embed your venue's map here</span>
      </div>
    </div>
  </div>
</section>

