  .divider { margin-bottom: 36px; }
  .divider::before, .divider::after { width: 34px; }

  /* --- Nav --- */
  .nav-inner { padding: 0; }
  .nav-logo { font-size: 1.05rem; }
  .nav-logo svg { width: 22px; height: 22px; }
  .nav-links { width: 82%; max-width: none; padding: 30px 26px; }

  /* --- Invitation veil --- */
  .invite-veil-monogram { width: 56px; height: 56px; margin-bottom: 16px; }
  .invite-veil-text { font-size: 0.95rem; }

  /* --- Hero --- */
  .hero { padding: 110px 18px 64px; min-height: 100svh; }
  .hero-frame { inset: 10px; }
  .hero-kicker { font-size: 1rem; margin-bottom: 16px; }
  .hero-name { font-size: clamp(2.6rem, 15vw, 3.6rem); }
  .hero-title { font-size: clamp(1.15rem, 5.5vw, 1.4rem); margin-bottom: 20px; }
  .hero-tagline { font-size: 0.95rem; margin-bottom: 30px; padding: 0 4px; }
  .hero-meta { font-size: 0.85rem; gap: 10px; margin-bottom: 34px; }
  .hero-actions { flex-direction: column; width: 100%; gap: 14px; }
  .scroll-cue { bottom: 20px; }

  /* --- Buttons: full width, comfortable touch target --- */
  .btn {
    width: 100%;
    justify-content: center;
    padding: 15px 24px;
    font-size: 0.88rem;
    min-height: 50px;
  }

  /* --- Intro / debutant portrait --- */
  .intro-portrait { max-width: 280px; }
  .portrait-ornament { width: 34px; height: 34px; }
  .portrait-ornament.tl { top: -14px; left: -14px; }
  .portrait-ornament.br { bottom: -14px; right: -14px; }
  .intro-copy h2 { font-size: 1.6rem; }
  .intro-lede { font-size: 1.1rem; }
  .intro-copy p { font-size: 0.92rem; max-width: none; }
  .intro-signature { font-size: 1.7rem; }

  /* --- Detail cards --- */
  .glass-card { padding: 30px 22px; }
  .glass-card .icon-ring { width: 52px; height: 52px; margin-bottom: 16px; }
  .glass-card .icon-ring svg { width: 22px; height: 22px; }
  .glass-card h3 { font-size: 1.15rem; }
  .glass-card .detail-highlight { font-size: 1.3rem; }

  /* --- Countdown: 2x2 grid instead of a cramped single row --- */
  .countdown-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  .countdown-unit { min-width: 0; width: 100%; padding: 20px 10px; }
  .countdown-num { font-size: clamp(2rem, 9vw, 2.6rem); }
  .countdown-label { font-size: 0.66rem; }

  /* --- 18 Roses / Candles / Treasures --- */
  .tradition-card { padding: 34px 22px; }
  .tradition-card .motif { width: 44px; height: 44px; margin-bottom: 16px; }
  .tradition-card h3 { font-size: 1.4rem; }
  .tradition-card .count { font-size: 2.1rem; }
  .tradition-slot { font-size: 0.85rem; }

  /* --- Program timeline: tighten the spine and hit target --- */
  .timeline-wrap::before { left: 14px; }
  .timeline-item { padding-left: 42px; padding-bottom: 32px; }
  .timeline-item .t-dot { left: 14px; width: 12px; height: 12px; }
  .timeline-item h3 { font-size: 1.1rem; }
  .timeline-item p { font-size: 0.88rem; }

  /* --- Gallery: single column, taller cards, captions always visible --- */
  .gallery-grid { grid-template-columns: 1fr; grid-auto-rows: 240px; gap: 14px; }
  .gallery-item.wide, .gallery-item.tall { grid-column: span 1; grid-row: span 1; }
  .gallery-item::after { opacity: 1; background: linear-gradient(0deg, rgba(11,19,48,0.75), transparent 60%); }
  .gallery-item span.caption { opacity: 1; transform: translateY(0); }

  /* --- Messages --- */
  .message-card { padding: 26px 22px; }
  .message-form-card { margin-top: 40px; }

  /* --- Forms --- */
  .form-panel { padding: 26px 18px; border-radius: var(--radius-sm); }
  .field { margin-bottom: 18px; }
  .field label { font-size: 0.76rem; }
  .field input, .field textarea, .field select { padding: 12px 14px; font-size: 0.92rem; }
  .radio-group { flex-direction: column; gap: 10px; }
  .radio-pill { padding: 14px; text-align: left; padding-left: 18px; }

  /* --- Venue --- */
  .venue-copy h3 { font-size: 1.5rem; }
  .venue-map-placeholder svg { width: 32px; height: 32px; }

  /* --- Closing --- */
  .closing { min-height: 80svh; padding: 0 20px; }
  .closing-message { font-size: 1.3rem; margin-bottom: 22px; }
  .closing-name { font-size: 2.4rem; }
  .closing-actions { flex-direction: column; width: 100%; gap: 12px; margin-top: 34px; }

  /* --- Footer + back to top --- */
  footer p { font-size: 0.74rem; padding: 0 12px; }
  .back-to-top { right: 14px; bottom: 14px; width: 42px; height: 42px; }
}

/* Extra-narrow phones (older/small devices) */
@media (max-width: 360px) {
  .hero-name { font-size: 2.3rem; }
  .countdown-grid { gap: 10px; }
  .countdown-unit { padding: 16px 6px; }
  .tradition-card, .glass-card, .message-card { padding: 24px 16px; }
}

