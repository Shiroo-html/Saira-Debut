  font-size: 0.82rem;
}

/* =========================================================
   BACK TO TOP
   ========================================================= */

.back-to-top {
  position: fixed;
  bottom: 28px;
  right: 28px;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: rgba(11, 19, 48, 0.85);
  border: 1px solid var(--gold);
  color: var(--gold-light);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 90;
  opacity: 0;
  visibility: hidden;
  transform: translateY(10px);
  transition: all 0.35s var(--ease);
  backdrop-filter: blur(8px);
}
.back-to-top.visible {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}
.back-to-top svg { width: 18px; height: 18px; }
.back-to-top:hover { background: rgba(212, 175, 106, 0.15); }

/* =========================================================
   RESPONSIVE — TABLET (≤980px)
   ========================================================= */

@media (max-width: 980px) {
  .intro-grid { grid-template-columns: 1fr; gap: 46px; }
  .intro-portrait { max-width: 420px; margin: 0 auto; }
  .detail-cards { grid-template-columns: 1fr; }
  .tradition-grid { grid-template-columns: 1fr; }
  .message-grid { grid-template-columns: 1fr; }
  .venue-grid { grid-template-columns: 1fr; }
  .gallery-grid { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 160px; }
  .gallery-item.wide { grid-column: span 2; }
}

/* =========================================================
   RESPONSIVE — LARGE PHONE / SMALL TABLET (≤720px)
   ========================================================= */

@media (max-width: 720px) {
  section { padding: 84px 0; }

  .nav-links {
